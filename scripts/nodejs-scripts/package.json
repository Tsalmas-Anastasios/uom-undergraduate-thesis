{
    "name": "nodejs-thesis-scripts",
    "version": "1.0.0",
    "description": "NodeJS server for thesis project in Applied Informatics at University of Macedonia.",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "server:dev": "nodemon ./src/bootstrap.ts",
        "db:create:migration": "cross-env NODE_OPTIONS='--experimental-transform-types' sequelize-cli migration:generate --options-path ./.sequelizerc.cjs --name",
        "db:migrate": "cross-env NODE_OPTIONS='--experimental-transform-types' sequelize-cli db:migrate --options-path ./.sequelizerc.cjs",
        "db:migrate:undo": "cross-env NODE_OPTIONS='--experimental-transform-types' sequelize-cli db:migrate:undo --options-path ./.sequelizerc.cjs",
        "db:migrate:undo:all": "cross-env NODE_OPTIONS='--experimental-transform-types' sequelize-cli db:migrate:undo:all --options-path ./.sequelizerc.cjs",
        "db:create:seed": "cross-env NODE_OPTIONS='--experimental-transform-types' sequelize-cli seed:generate --options-path ./.sequelizerc.cjs --name",
        "db:seed": "cross-env NODE_OPTIONS='--experimental-transform-types' sequelize-cli db:seed:all --options-path ./.sequelizerc.cjs",
        "db:seed:undo": "cross-env NODE_OPTIONS='--experimental-transform-types' sequelize-cli db:seed:undo:all --options-path ./.sequelizerc.cjs",
        "db:open": "docker compose up",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "tsc": "tsc",
        "test": "echo \"Error: no test specified\" && exit 1",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tsalmas-Anastasios/applied-informatics-uom-bachelor-thesis.git"
    },
    "keywords": [
        "NodeJS",
        "Express",
        "TypeScript",
        "Sequelize",
        "PostgreSQL",
        "Thesis",
        "Code Quality",
        "ESLint",
        "Applied Informatics",
        "Code Security",
        "University of Macedonia",
        "UOM"
    ],
    "author": "Anastasios Tsalmas",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Tsalmas-Anastasios/applied-informatics-uom-bachelor-thesis/issues"
    },
    "homepage": "https://github.com/Tsalmas-Anastasios/applied-informatics-uom-bachelor-thesis#readme",
    "dependencies": {
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "connect-pg-simple": "^10.0.0",
        "cors": "^2.8.5",
        "cross-env": "^10.1.0",
        "dotenv": "^17.2.3",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "express-session": "^1.18.2",
        "lodash": "^4.17.21",
        "moment-timezone": "^0.6.0",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "nanoid": "^5.1.6",
        "pg": "^8.16.3",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.7",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-react": "^7.27.1",
        "@babel/preset-typescript": "^7.27.1",
        "@eslint/css": "^0.12.0",
        "@eslint/js": "^9.37.0",
        "@sonar/scan": "^4.3.5",
        "@types/bcrypt": "^6.0.0",
        "@types/connect-pg-simple": "^7.0.3",
        "@types/cors": "^2.8.19",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.7.1",
        "@types/pg": "^8.15.6",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "babel-loader": "^10.0.0",
        "baseline-browser-mapping": "^2.9.7",
        "dotenv-webpack": "^8.1.1",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.0.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-sonarjs": "^3.0.5",
        "eslint-plugin-testing-library": "^7.13.1",
        "eslint-plugin-unicorn": "^61.0.2",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "sequelize-cli": "^6.6.3",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.0"
    },
    "engines": {
        "node": "^22.0.0",
        "npm": "^10.0.0"
    }
}
